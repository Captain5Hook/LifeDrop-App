# GEMINI_API_KEY: Required ONLY on the Cloudflare Worker proxy (never in client bundle).
# Configure via `wrangler secret put GEMINI_API_KEY` or AI Studio Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Firebase App Check reCAPTCHA v3 site key (public browser key, safe for Vite client).
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# Cloudflare Worker URL for LifeDrop Assistant (used in Milestone 5).
VITE_CHAT_WORKER_URL=""
