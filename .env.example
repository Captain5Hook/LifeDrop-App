# Server-side Cloudflare Worker secret (configure via `wrangler secret put GEMINI_API_KEY`; leave empty locally)
GEMINI_API_KEY=""

# Public application URL (optional; injected at runtime or set to your Hosting URL)
APP_URL=""

# Optional Firebase App Check reCAPTCHA v3 public site key (browser-safe Vite env var)
VITE_FIREBASE_APP_CHECK_SITE_KEY=""

# Optional Cloudflare Worker HTTPS endpoint for online Gemini Assistant fallback (browser-safe Vite env var)
VITE_CHAT_WORKER_URL=""
