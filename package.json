{
  "name": "lifedrop",
  "private": true,
  "version": "1.0.0",
  "description": "Zero-cost Indian blood bank, donor SOS, and offline bleeding emergency first-aid PWA.",
  "keywords": [
    "blood-bank",
    "lifedrop",
    "pwa",
    "react",
    "typescript",
    "firebase",
    "leaflet",
    "india"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "eval:assistant": "tsx scripts/eval-assistant.ts",
    "test:rules": "tsx scripts/firestore-rules.test.ts",
    "test:rules:emulator": "firebase emulators:exec --only firestore \"npx tsx scripts/firestore-rules.test.ts\"",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.23",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^13.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.1",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
